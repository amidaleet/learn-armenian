#!/usr/bin/env bash

set -eo pipefail

_THIS_DIR=$(cd "$(dirname "$0")" && pwd)
export GIT_ROOT="$_THIS_DIR"
export ROOT_XFILE_PATH="$GIT_ROOT/Xfile"
cd "$GIT_ROOT"

source "$GIT_ROOT/Xfile_source/impl.sh"

link_child_xfile "$GIT_ROOT/Xfile_source/tests/tests.sh" '' test_xfile

JOURNAL_PY="$GIT_ROOT/script/journal.py"
SERVE_PY="$GIT_ROOT/script/serve.py"

# ---------- Journal ----------

## -f --focus
function session { ## Зафиксировать старт занятия в log/YYYY-MM-DD.md
  local FOCUS
  read_opt -f --focus FOCUS
  python3 "$JOURNAL_PY" session --focus "$FOCUS"
}

# ---------- Games ----------

## -p --port
function serve { ## HTTP-сервер с корня репо (игры пишут раунды в журнал)
  local PORT
  read_opt -p --port PORT
  PORT=${PORT:-8000}
  python3 "$SERVE_PY" --port "$PORT"
}

begin_xfile_task
